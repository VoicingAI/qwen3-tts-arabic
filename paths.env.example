# Copy to paths.env. paths.env is not committed.
# Leave QWEN_DATA_ROOT unset when you launch a Modal job. Modal always mounts
# the volume at /data. Set it only for a local run.

QWEN_DATA_ROOT=/data
QWEN3_TTS_DIR=/opt/Qwen3-TTS

